# Formatting rules for the ray tracer. Apply with:
#   cmake --build build --target format
# or: clang-format -i <files>
# Third-party headers in src/external are excluded (see .clang-format-ignore).
---
Language: Cpp
BasedOnStyle: LLVM
Standard: c++17

IndentWidth: 4
ColumnLimit: 100
AccessModifierOffset: -4
NamespaceIndentation: None
IndentCaseLabels: true
PointerAlignment: Left

# Opening braces go on their own line (Allman style)
BreakBeforeBraces: Allman

# Control flow is never squeezed onto one line: an if/loop body always gets its own line.
# Short member functions defined inside a class (getters, trivial operators) may stay on one
# line, as may empty bodies; everything else is broken out.
SeparateDefinitionBlocks: Always
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AllowShortLambdasOnASingleLine: Inline

# Every if/else/loop body gets braces, even a single statement
InsertBraces: true

# Keep the aligned "cam.x = ..." blocks and trailing comments tidy
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveDeclarations: None
AlignTrailingComments: true

AlwaysBreakTemplateDeclarations: Yes
BinPackArguments: true
BinPackParameters: true

# Some headers rely on a #define coming right before an #include (stb, tinyobj)
SortIncludes: Never
IncludeBlocks: Preserve

MaxEmptyLinesToKeep: 1
InsertNewlineAtEOF: true
...
